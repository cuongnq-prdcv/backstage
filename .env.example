# Example environment variables for hello-terragrunt-backstage.
# Copy to .env and fill in real values. NEVER commit real secrets — .env is gitignored.

# --- GitHub integration (used to clone/push/open PRs on the live repos) -------
# Personal Access Token with repo contents + pull-request read/write on the live repos.
GITHUB_TOKEN=

# --- Crossplane tenant provisioning (tenant:provision-crossplane action) -----
# The Crossplane "live" repository that holds tenant XTenantEnvironment XR manifests
# (layout: tenants/<tenant-name>/<environment>/xr.yaml).
CROSSPLANE_LIVE_REPO_URL=
CROSSPLANE_LIVE_REPO_BRANCH=main

# --- Tenant onboarding (onboarding:create-jira-issue action + lookup) ---------
# Jira Cloud site and credentials used to file and look up onboarding requests.
# JIRA_API_TOKEN is a secret — create one at https://id.atlassian.net/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Shared secret matched against the Jira Automation webhook's X-Onboarding-Token header (secret).
JIRA_WEBHOOK_SECRET=

# --- Onboarding completion email (Jira Done webhook → SMTP) -------------------
# SMTP transport used to email the contact once their onboarding issue is Done.
# Simplest to test with a Mailtrap sandbox inbox (https://mailtrap.io). SMTP_PASSWORD is a secret.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Production database (only needed for app-config.production.yaml) ---------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=

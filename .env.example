# Example environment variables for hello-terragrunt-backstage.
# Copy to .env and fill in real values. NEVER commit real secrets — .env is gitignored.

# --- GitHub integration (used to clone/push/open PRs on the live repos) -------
# Personal Access Token with repo contents + pull-request read/write on the live repos.
GITHUB_TOKEN=

# --- Crossplane tenant provisioning (tenant:provision-crossplane action) -----
# The Crossplane "live" repository that holds tenant TenantEnvironment manifests
# (layout: examples/tenantenvironments/<tenant>-<environment>.yaml).
CROSSPLANE_LIVE_REPO_URL=
CROSSPLANE_LIVE_REPO_BRANCH=main

# --- Production database (only needed for app-config.production.yaml) ---------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
